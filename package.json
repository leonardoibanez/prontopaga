{
  "name": "consulta-riesgo-financiero",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w backend"
  },
  "devDependencies": { "concurrently": "^9.2.0" }
}
