{
  "name": "@consulta-riesgo/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.cjs\"",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:coverage": "npm run build && c8 --all --include=\"dist/**/*.js\" --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines=95 --branches=75 --functions=95 node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^18.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
